{% extends 'base.html.twig' %}

{% block title %}Horario index{% endblock %}

{% block body %}
    <h1>Horario index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Dia</th>
                <th>Horario_inicio</th>
                <th>Horario_fin</th>
                <th>Cant_modulos</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for horario in horarios %}
            <tr>
                <td>{{ horario.id }}</td>
                <td>{{ horario.Dia }}</td>
                <td>{{ horario.HorarioInicio }}</td>
                <td>{{ horario.HorarioFin }}</td>
                <td>{{ horario.CantModulos }}</td>
                <td>
                    <a href="{{ path('app_horario_show', {'id': horario.id}) }}">show</a>
                    <a href="{{ path('app_horario_edit', {'id': horario.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_horario_new') }}">Create new</a>
{% endblock %}
